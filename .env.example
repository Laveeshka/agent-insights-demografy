# Copy this file to .env and fill in real credentials. Do NOT commit and push secrets.

# Path to Google service account JSON (BigQuery)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Gemini (Google) API Key for Gemini 2.5 Flash-Lite
GEMINI_API_KEY=your-gemini-api-key

# BigQuery project
BIGQUERY_PROJECT=demografy

# LangChain / LangSmith tracing and API key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-key


